{
 "schema": "state-machine",
 "vertices": [
  {"id": "start", "kind": "initial", "label": ""},
  {"id": "edit", "kind": "composite state", "label": "Edit mode"},
  {"id": "idle", "kind": "state", "label": "Idle", "attrs": {"internal": "Tab / select the next vertex; Delete, an arrow, Ctrl-Z, Ctrl-Y / a command; Context / select what is hit for the host's actions"}, "parent": "edit"},
  {"id": "press", "kind": "choice", "label": "under it?", "parent": "edit"},
  {"id": "gesture", "kind": "composite state", "label": "Pointer gesture", "attrs": {"internal": "a key other than Escape: ignored", "exit": "drop what the gesture held"}, "parent": "edit"},
  {"id": "selecting", "kind": "state", "label": "Selecting", "parent": "gesture", "attrs": {"internal": "Move / draw the marquee; Press: ignored, a second pointer"}},
  {"id": "dragging", "kind": "state", "label": "Dragging", "parent": "gesture", "attrs": {"internal": "Move / move the selection; Press: ignored, a second pointer"}},
  {"id": "connecting", "kind": "state", "label": "Connecting", "parent": "gesture", "attrs": {"internal": "Move / draw the edge to the pointer; Press / only the pointer moves"}},
  {"id": "placing", "kind": "state", "label": "Placing", "parent": "gesture", "attrs": {"internal": "Move / the new vertex follows the pointer; Press / only the pointer moves"}},
  {"id": "panning", "kind": "state", "label": "Panning", "parent": "gesture", "attrs": {"internal": "Move / pan the view; Press: ignored, a second pointer"}},
  {"id": "resizing", "kind": "state", "label": "Resizing", "parent": "gesture", "attrs": {"internal": "Move / draw the new size; Press: ignored, a second pointer"}},
  {"id": "editing", "kind": "state", "label": "EditingText", "attrs": {"entry": "the host shows an input for the label, or the attribute its kind edits", "exit": "the host hides it", "internal": "Move, Release, a key: ignored; the input has the keyboard"}, "parent": "edit"},
  {"id": "view", "kind": "composite state", "label": "View mode", "attrs": {"internal": "entered at Idle; Tab / select the next vertex; Context / select what is hit; Escape, Blur / cancel; a command, the palette, a label: refused"}},
  {"id": "vidle", "kind": "state", "label": "Idle", "parent": "view", "attrs": {"internal": "Press on a vertex, a port or an edge / select it"}},
  {"id": "vpanning", "kind": "state", "label": "Panning", "parent": "view", "attrs": {"internal": "Move / pan the view"}},
  {"id": "vselecting", "kind": "state", "label": "Selecting", "parent": "view", "attrs": {"internal": "Move / draw the marquee"}},
  {"id": "held", "kind": "composite state", "label": "Held", "attrs": {"internal": "entered at Idle; Tab, Context, Escape as in Idle; another press, a command, the palette, a label: refused"}},
  {"id": "hidle", "kind": "state", "label": "Idle", "parent": "held"},
  {"id": "hpanning", "kind": "state", "label": "Panning", "parent": "held", "attrs": {"internal": "Move / pan the view"}},
  {"id": "vheld", "kind": "composite state", "label": "Held in view mode", "attrs": {"internal": "entered at Idle; as Held"}},
  {"id": "vhidle", "kind": "state", "label": "Idle", "parent": "vheld"},
  {"id": "vhpanning", "kind": "state", "label": "Panning", "parent": "vheld", "attrs": {"internal": "Move / pan the view"}}
 ],
 "edges": [
  {"id": "t1", "kind": "transition", "from": "start", "to": "idle", "label": "New"},
  {"id": "t2", "kind": "transition", "from": "idle", "to": "press", "label": "Press", "attrs": {"event": "Press"}},
  {"id": "t3", "kind": "transition", "from": "press", "to": "panning", "label": "[middle button or Alt]", "attrs": {"guard": "middle button or Alt"}},
  {"id": "t4", "kind": "transition", "from": "press", "to": "resizing", "label": "[resize handle]", "attrs": {"guard": "on the resize handle of the one selected vertex"}},
  {"id": "t5", "kind": "transition", "from": "press", "to": "dragging", "label": "[vertex] / select", "attrs": {"guard": "on a vertex", "actions": "select it, adding to the selection with Shift; remember where the vertices to drag are"}},
  {"id": "t6", "kind": "transition", "from": "press", "to": "connecting", "label": "[port or outline]", "attrs": {"guard": "on a port or an outline", "actions": "remember the port or outline the edge starts at"}},
  {"id": "t7", "kind": "transition", "from": "press", "to": "selecting", "label": "[background]", "attrs": {"guard": "on the background", "actions": "select nothing, unless Shift is held"}},
  {"id": "t8", "kind": "transition", "from": "press", "to": "idle", "label": "[edge] / select", "attrs": {"guard": "on an edge", "actions": "select it, adding to the selection with Shift"}},
  {"id": "t9", "kind": "transition", "from": "idle", "to": "placing", "label": "PaletteVertex", "attrs": {"event": "PaletteVertex", "actions": "remember the vertex kind"}},
  {"id": "t10", "kind": "transition", "from": "gesture", "to": "idle", "label": "Release / finish", "attrs": {"event": "Release", "actions": "move the selection, select in the marquee or resize, if the pointer moved; add the edge or the vertex; by command"}},
  {"id": "t11", "kind": "transition", "from": "gesture", "to": "idle", "label": "Escape, Blur / cancel", "attrs": {"event": "Escape, Blur, TextCancel, PaletteEdge, Context, DoubleClick on the background", "actions": "put a drag back where it began; for PaletteEdge, choose the edge kind; for Context, select what is hit, unless it is selected"}},
  {"id": "t12", "kind": "transition", "from": "idle", "to": "editing", "label": "Enter, F2, a key [one selected]", "attrs": {"event": "Enter, F2, a printable key", "guard": "one element selected"}},
  {"id": "t13", "kind": "transition", "from": "idle", "to": "editing", "label": "DoubleClick [element] / select", "attrs": {"event": "DoubleClick", "guard": "on a vertex, a port, an outline or an edge", "actions": "select it alone"}},
  {"id": "t14", "kind": "transition", "from": "editing", "to": "idle", "label": "TextDone / relabel", "attrs": {"event": "TextDone", "actions": "set the label, or the attribute its kind edits, by command"}},
  {"id": "t15", "kind": "transition", "from": "editing", "to": "idle", "label": "TextCancel, Escape", "attrs": {"event": "TextCancel, Escape, Blur, PaletteEdge, Context, DoubleClick on the background", "actions": "for PaletteEdge, choose the edge kind; for Context, select what is hit, unless it is selected"}},
  {"id": "t16", "kind": "transition", "from": "editing", "to": "press", "label": "Press / end editing", "attrs": {"event": "Press", "actions": "end the editing; the host commits the text first"}},
  {"id": "t17", "kind": "transition", "from": "connecting", "to": "panning", "label": "[middle button or Alt]", "attrs": {"event": "Press", "guard": "middle button or Alt"}},
  {"id": "t18", "kind": "transition", "from": "placing", "to": "panning", "label": "[middle button or Alt]", "attrs": {"event": "Press", "guard": "middle button or Alt"}},
  {"id": "t19", "kind": "transition", "from": "gesture", "to": "editing", "label": "DoubleClick [element]", "attrs": {"event": "DoubleClick", "guard": "on a vertex, a port, an outline or an edge", "actions": "put a drag back where it began; select it alone"}},
  {"id": "t20", "kind": "transition", "from": "editing", "to": "placing", "label": "PaletteVertex", "attrs": {"event": "PaletteVertex", "actions": "remember the vertex kind"}},
  {"id": "t21", "kind": "transition", "from": "gesture", "to": "placing", "label": "PaletteVertex", "attrs": {"event": "PaletteVertex", "actions": "put a drag back where it began; remember the vertex kind"}},
  {"id": "t22", "kind": "transition", "from": "vidle", "to": "vpanning", "label": "Press [middle or Alt]"},
  {"id": "t23", "kind": "transition", "from": "vidle", "to": "vselecting", "label": "Press [background]"},
  {"id": "t24", "kind": "transition", "from": "vpanning", "to": "vidle", "label": "Release"},
  {"id": "t25", "kind": "transition", "from": "vselecting", "to": "vidle", "label": "Release / select"},
  {"id": "t26", "kind": "transition", "from": "hidle", "to": "hpanning", "label": "Press [middle or Alt]"},
  {"id": "t27", "kind": "transition", "from": "hpanning", "to": "hidle", "label": "Release"},
  {"id": "t28", "kind": "transition", "from": "vhidle", "to": "vhpanning", "label": "Press [middle or Alt]"},
  {"id": "t29", "kind": "transition", "from": "vhpanning", "to": "vhidle", "label": "Release"},
  {"id": "t30", "kind": "transition", "from": "edit", "to": "view", "label": "View / cancel"},
  {"id": "t31", "kind": "transition", "from": "view", "to": "edit", "label": "Edit / cancel"},
  {"id": "t32", "kind": "transition", "from": "edit", "to": "held", "label": "Hold / cancel"},
  {"id": "t33", "kind": "transition", "from": "held", "to": "edit", "label": "Unhold"},
  {"id": "t34", "kind": "transition", "from": "view", "to": "vheld", "label": "Hold / cancel"},
  {"id": "t35", "kind": "transition", "from": "vheld", "to": "view", "label": "Unhold"},
  {"id": "t36", "kind": "transition", "from": "held", "to": "vheld", "label": "View"},
  {"id": "t37", "kind": "transition", "from": "vheld", "to": "held", "label": "Edit"}
 ]
}
